# Copy to .env and fill in. Never commit the real .env file.

# --- Core ---
LOOKUP_CLI_CACHE_DB_PATH=~/.lookup-cli/cache.sqlite3
LOOKUP_CLI_CACHE_TTL_SECONDS=3600

# --- Okta (Stage 2) ---
OKTA_ORG_URL=https://your-org.okta.com
OKTA_API_TOKEN=
# Optional: per-request timeout in seconds (default 10).
# OKTA_TIMEOUT_SECONDS=10
# Optional: custom Universal Directory attribute carrying this org's access
# decision. Shown in the Okta Profile Editor as "ACCESS BLOCKED". Override
# only if your org named the attribute something else.
# OKTA_ACCESS_ATTRIBUTE=access_blocked
# Optional: serve a fixture instead of calling Okta, so the CLI can be
# tried with no credentials at all.
# LOOKUP_CLI_MOCK_OKTA=1

# --- Jira (Stage 3) ---
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- Jamf (Stage 4) ---
# Not yet available -- runs in mock mode until credentials are provisioned.
LOOKUP_CLI_MOCK_JAMF=1
JAMF_BASE_URL=
JAMF_CLIENT_ID=
JAMF_CLIENT_SECRET=


# --- allwhere (Stage 6) ---
# Not yet available -- runs in mock mode until credentials are provisioned.
LOOKUP_CLI_MOCK_ALLWHERE=1
ALLWHERE_API_KEY=

# --- CAIRO / TPRM (vendor + application risk register) ---
# Internal API: vendors, their applications, and whether each application is
# approved for use in our space.
CAIRO_BASE_URL=https://your-tprm-host.internal
CAIRO_API_KEY=
# How the key is sent. Set to the scheme CAIRO expects:
#   bearer   ->  Authorization: Bearer <key>
#   apikey   ->  X-API-Key: <key>
# Leave unset to default to bearer.
# CAIRO_AUTH_SCHEME=bearer
# Optional: per-request timeout in seconds (default 10).
# CAIRO_TIMEOUT_SECONDS=10
# Optional: serve a fixture instead of calling CAIRO.
# LOOKUP_CLI_MOCK_CAIRO=1
